# Configuración del servidor de desarrollo Vite
# Copia este archivo a .env y ajusta los valores según necesites

# Puerto por defecto (Vite usará el siguiente disponible si está ocupado)
VITE_PORT=5173

# Host del servidor (localhost o 0.0.0.0 para acceso desde red)
VITE_HOST=localhost

# Abrir navegador automáticamente al iniciar
VITE_OPEN=true
