# Reglas Globales de Seguridad para todas las rutas
/*
  # Previene que la aplicación sea embebida en frames de cualquier origen (Anti-Clickjacking Legacy)
  X-Frame-Options: DENY

  # Bloquea ataques de confusión y sniffing de tipo MIME
  X-Content-Type-Options: nosniff

  # Protege la privacidad evitando enviar rutas completas en cabeceras de Referer a terceros
  Referrer-Policy: strict-origin-when-cross-origin

  # Fuerza HTTPS estricto con subdominios y registro en listas HSTS Preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Aislamiento de ventanas: Mitiga ataques Spectre y secuestro de ventanas vía window.opener manteniendo compatibilidad con pasarelas de pago y popups
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # Previene que otros sitios consuman recursos internos de Turnes de forma no autorizada
  Cross-Origin-Resource-Policy: same-origin

  # Control de Privacidad y Sensores de Hardware (Zero-Trust): Restringe 28 APIs de navegador
  Permissions-Policy: camera=(self "https://*.daily.co"), microphone=(self "https://*.daily.co"), display-capture=(self "https://*.daily.co"), geolocation=(self), payment=(self "https://checkout.wompi.co" "https://*.wompi.co"), screen-wake-lock=(self), accelerometer=(), ambient-light-sensor=(), autoplay=(self "https://*.daily.co"), battery=(), bluetooth=(), browsing-topics=(), clipboard-read=(), cross-origin-isolated=(), direct-sockets=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), gamepad=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), midi=(), otp-credentials=(), publickey-credentials-create=(), publickey-credentials-get=(), serial=(), storage-access=(), sync-xhr=(), usb=(), window-management=()

  # Content Security Policy (Fintech Tier 1):
  # - Eliminado 'unsafe-eval' (Mitigación total contra evaluación de strings como JS)
  # - Purgado unpkg.com (Cierre de vector de evasión CSP por CDNs abiertos)
  # - frame-ancestors 'none' (Defensa contra Clickjacking Nivel 3)
  # - script-src-attr 'none' (Bloqueo absoluto de inyección de atributos de eventos inline onclick/onload/onerror)
  # - Habilitado Nominatim OSM en connect-src para geolocalización inversa
  # - upgrade-insecure-requests activado
  Content-Security-Policy: default-src 'self' https://turnes.co https://*.turnes.co; script-src 'self' 'unsafe-inline' blob: https://turnes.co https://*.turnes.co https://checkout.wompi.co https://*.wompi.co https://static.cloudflareinsights.com https://challenges.cloudflare.com https://*.cloudflare.com; script-src-elem 'self' 'unsafe-inline' blob: https://turnes.co https://*.turnes.co https://checkout.wompi.co https://*.wompi.co https://static.cloudflareinsights.com https://challenges.cloudflare.com https://*.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://turnes.co https://*.turnes.co https://*.supabase.co https://*.supabase.in https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://ui-avatars.com https://api.dicebear.com https://placehold.co https://images.unsplash.com https://www.transparenttextures.com; connect-src 'self' blob: data: https://turnes.co https://*.turnes.co https://*.supabase.co wss://*.supabase.co https://*.supabase.in https://*.sentry.io https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://*.daily.co wss://*.daily.co https://*.wompi.co https://checkout.wompi.co https://production.wompi.co https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.cloudflare.com https://nominatim.openstreetmap.org; frame-src 'self' https://turnes.co https://*.turnes.co https://checkout.wompi.co https://*.wompi.co https://*.daily.co https://challenges.cloudflare.com https://*.cloudflare.com; media-src 'self' blob: https://*.supabase.co; worker-src 'self' blob:; child-src 'self' blob: https://turnes.co https://*.turnes.co https://*.daily.co https://checkout.wompi.co; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.wompi.co https: