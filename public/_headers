# ==============================================================================
# ⚡ POLÍTICAS DE CACHÉ Y PWA (Cloudflare Pages)
# ==============================================================================

# 1. Assets estáticos compilados con Content Hash (Vite)
# Inmutables por 1 año para máximo rendimiento
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# 2. Archivos estáticos de medios y texturas
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# 3. Service Worker, Manifest, y documentos PWA
# Nunca deben cachearse en CDN ni disco para evitar versiones desactualizadas
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Service-Worker-Allowed: /
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
