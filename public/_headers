# ⚡ Reglas de Caché (Cloudflare Pages)

# 1. Los assets generados por Vite (JS, CSS) tienen hash.
# ¡Nunca cambian! Se pueden cachear de forma agresiva por 1 año.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Las imágenes y media general
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# 3. Service Worker, Manifest, y el HTML principal
# Para aplicaciones PWA (Turnes), esto asegura que el navegador SIEMPRE pida la versión más nueva, previniendo el "Loop de la muerte".
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
